Prefix(:=<urn:mateclaw:fixture:quality:>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<urn:mateclaw:fixture:quality> <urn:mateclaw:fixture:quality:v1>
 Annotation(rdfs:comment "Synthetic quality fixture; relationships are not physical causal proof.")
 Declaration(Class(:Equipment))
 Declaration(Class(:CMM))
 Declaration(Class(:Probe))
 Declaration(Class(:Controller))
 Declaration(Class(:MeasurementProgram))
 Declaration(Class(:EnvironmentObservation))
 Declaration(Class(:CalibrationRecord))
 Declaration(Class(:Measurement))
 Declaration(Class(:ToleranceSpecification))
 SubClassOf(:CMM :Equipment)
 DisjointClasses(:Measurement :ToleranceSpecification)
 AnnotationAssertion(rdfs:label :CMM "三坐标测量机"@zh)
 AnnotationAssertion(rdfs:label :Probe "测针"@zh)
 AnnotationAssertion(rdfs:label :Measurement "实测记录"@zh)
 AnnotationAssertion(rdfs:label :ToleranceSpecification "公差规范"@zh)
 Declaration(ObjectProperty(:hasProbe))
 ObjectPropertyDomain(:hasProbe :CMM)
 ObjectPropertyRange(:hasProbe :Probe)
 Declaration(ObjectProperty(:hasController))
 ObjectPropertyDomain(:hasController :CMM)
 ObjectPropertyRange(:hasController :Controller)
 Declaration(ObjectProperty(:measuredBy))
 ObjectPropertyDomain(:measuredBy :Measurement)
 ObjectPropertyRange(:measuredBy :CMM)
 Declaration(ObjectProperty(:usedProgram))
 ObjectPropertyDomain(:usedProgram :Measurement)
 ObjectPropertyRange(:usedProgram :MeasurementProgram)
 Declaration(ObjectProperty(:evaluatedAgainst))
 ObjectPropertyDomain(:evaluatedAgainst :Measurement)
 ObjectPropertyRange(:evaluatedAgainst :ToleranceSpecification)
 Declaration(ObjectProperty(:environmentDuring))
 ObjectPropertyDomain(:environmentDuring :Measurement)
 ObjectPropertyRange(:environmentDuring :EnvironmentObservation)
 Declaration(ObjectProperty(:calibrationOf))
 ObjectPropertyDomain(:calibrationOf :CalibrationRecord)
 ObjectPropertyRange(:calibrationOf :Equipment)
 Declaration(DataProperty(:observedValue))
 DataPropertyDomain(:observedValue :Measurement)
 DataPropertyRange(:observedValue xsd:decimal)
 Declaration(DataProperty(:upperLimit))
 DataPropertyDomain(:upperLimit :ToleranceSpecification)
 DataPropertyRange(:upperLimit xsd:decimal)
 Declaration(DataProperty(:unit))
 DataPropertyRange(:unit xsd:string)
 Declaration(DataProperty(:temperature))
 DataPropertyDomain(:temperature :EnvironmentObservation)
 DataPropertyRange(:temperature xsd:decimal)
 Declaration(DataProperty(:programVersion))
 DataPropertyDomain(:programVersion :MeasurementProgram)
 DataPropertyRange(:programVersion xsd:string)
 Declaration(DataProperty(:recordedAt))
 DataPropertyRange(:recordedAt xsd:dateTime)
 SubClassOf(:Measurement ObjectSomeValuesFrom(:measuredBy :CMM))
 SubClassOf(:Measurement ObjectAllValuesFrom(:evaluatedAgainst :ToleranceSpecification))
)
