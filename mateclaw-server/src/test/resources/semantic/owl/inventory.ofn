Prefix(:=<urn:mateclaw:fixture:inventory:>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<urn:mateclaw:fixture:inventory> <urn:mateclaw:fixture:inventory:v1>
 Annotation(rdfs:comment "Synthetic inventory fixture; observed stock and reorder policy remain separate.")
 Declaration(Class(:Item))
 Declaration(Class(:Location))
 Declaration(Class(:StockObservation))
 Declaration(Class(:ReorderPolicy))
 DisjointClasses(:StockObservation :ReorderPolicy)
 AnnotationAssertion(rdfs:label :Item "物料"@zh)
 AnnotationAssertion(rdfs:label :Location "库位"@zh)
 Declaration(ObjectProperty(:forItem))
 ObjectPropertyRange(:forItem :Item)
 Declaration(ObjectProperty(:atLocation))
 ObjectPropertyDomain(:atLocation :StockObservation)
 ObjectPropertyRange(:atLocation :Location)
 Declaration(ObjectProperty(:evaluatedAgainst))
 ObjectPropertyDomain(:evaluatedAgainst :StockObservation)
 ObjectPropertyRange(:evaluatedAgainst :ReorderPolicy)
 Declaration(DataProperty(:observedQuantity))
 DataPropertyDomain(:observedQuantity :StockObservation)
 DataPropertyRange(:observedQuantity xsd:decimal)
 Declaration(DataProperty(:reorderPoint))
 DataPropertyDomain(:reorderPoint :ReorderPolicy)
 DataPropertyRange(:reorderPoint xsd:decimal)
 Declaration(DataProperty(:unit))
 DataPropertyRange(:unit xsd:string)
 Declaration(DataProperty(:recordedAt))
 DataPropertyRange(:recordedAt xsd:dateTime)
 SubClassOf(:StockObservation ObjectSomeValuesFrom(:forItem :Item))
 SubClassOf(:StockObservation ObjectSomeValuesFrom(:atLocation :Location))
)
