      "checks": [
        "expand-collapse-reopen"
      ]
    },
    {
      "id": "draft-cardinality",
      "page": "draft",
      "name": "限定基数",
      "locator": "expression panel: cardinality",
      "checks": [
        "inspect-values"
      ]
    },
    {
      "id": "draft-chain",
      "page": "draft",
      "name": "有序属性链",
      "locator": "expression panel: chain",
