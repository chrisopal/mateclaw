{
  "scope": "E2 second batch expression UI on draft and published pages; E1/E3 replay separately",
  "environment": "Chromium enterprise :5189 / OWL :18109; isolated synthetic data",
  "pages": [
    {
      "id": "draft",
      "url": "/semantic/ontologies/:id/edit",
      "inventoryComplete": true
