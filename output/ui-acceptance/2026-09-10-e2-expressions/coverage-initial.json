{
  "scope": "E2 second batch expression UI on draft and published pages; E1/E3 replay separately",
  "environment": "Chromium enterprise :5189 / OWL :18109; isolated synthetic data",
  "pages": [
    {
      "id": "draft",
      "url": "/semantic/ontologies/:id/edit",
      "inventoryComplete": true
    },
    {
      "id": "published",
      "url": "/semantic/ontologies/:id/versions",
      "inventoryComplete": true
    }
  ],
  "controls": [
    {
      "id": "draft-tree",
      "page": "draft",
      "name": "嵌套表达式树",
      "locator": "expression panel: tree",
      "checks": [
        "expand-collapse-reopen"
      ]
    },
    {
      "id": "draft-cardinality",
      "page": "draft",
      "name": "限定基数",
      "locator": "expression panel: cardinality",
      "checks": [
        "inspect-values"
      ]
    },
    {
      "id": "draft-chain",
      "page": "draft",
      "name": "有序属性链",
      "locator": "expression panel: chain",
      "checks": [
        "ordered-steps"
      ]
    },
    {
      "id": "draft-source",
      "page": "draft",
      "name": "表达式公理来源",
      "locator": "expression panel: source",
      "checks": [
        "inspect-source"
      ]
    },
    {
      "id": "draft-language",
      "page": "draft",
      "name": "表达式命名引用语言",
      "locator": "expression panel: language",
      "checks": [
        "switch-blur"
      ]
    },
    {
      "id": "draft-narrow",
      "page": "draft",
      "name": "窄屏表达式树",
      "locator": "expression panel: narrow",
      "checks": [
        "390px-overflow"
      ]
    },
    {
      "id": "draft-reload",
      "page": "draft",
      "name": "刷新与只读回读",
      "locator": "expression panel: reload",
      "checks": [
        "reload-readback"
      ]
    },
